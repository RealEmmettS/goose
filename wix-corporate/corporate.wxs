<?xml version='1.0' encoding='windows-1252'?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='honk300 (Corporate Edition)'
        UpgradeCode='247D60BB-5DD4-4D99-9F1B-D6AD52FA4FC7'
        Manufacturer='Emmett S'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='Desktop goose for your screen (Corporate Edition, per-user install)'
            Manufacturer='Emmett S'
            InstallerVersion='500'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='honk300'>
                        <Component Id='LegalNotices' Guid='31F89180-03BF-4BE4-B62B-69270D7C73E6'>
                            <File Id='LicenseFile' Name='LICENSE' DiskId='1' Source='$(var.SourceRoot)\LICENSE' KeyPath='yes'/>
                            <File Id='ThirdPartyAssetsFile' Name='THIRD_PARTY_ASSETS.md' DiskId='1' Source='$(var.SourceRoot)\THIRD_PARTY_ASSETS.md'/>
                        </Component>
                        <Directory Id='Bin' Name='bin'>
                            <Component Id='Path' Guid='103257E6-F862-4C5B-A921-104C5ACFA761' KeyPath='yes'>
                                <Environment
                                    Id='PATH'
                                    Name='PATH'
                                    Value='[Bin]'
                                    Permanent='no'
                                    Part='last'
                                    Action='set'
                                    System='no'/>
                            </Component>
                            <Component Id='Honk300Exe' Guid='*'>
                                <File Id='Honk300ExeFile' Name='honk300.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\honk300.exe' KeyPath='yes'/>
                            </Component>
                            <Component Id='HonkAliasExe' Guid='*'>
                                <File Id='HonkAliasExeFile' Name='honk.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\honk300.exe' KeyPath='yes'/>
                            </Component>
                            <Component Id='GooseAliasExe' Guid='*'>
                                <File Id='GooseAliasExeFile' Name='goose.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\honk300.exe' KeyPath='yes'/>
                            </Component>
                            <Component Id='InstallSourceMarkerFile' Guid='*'>
                                <File Id='InstallSourceFile' Name='install-source.txt' DiskId='1' Source='wix-corporate\install-source-msi-corporate.txt' KeyPath='yes'/>
                            </Component>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='honk300'/>
            </Directory>
        </Directory>

        <DirectoryRef Id='APPLICATIONFOLDER'>
            <Component Id='InstallSourceMarker' Guid='*'>
                <RegistryValue
                    Root='HKCU'
                    Key='Software\Honk300'
                    Name='InstallSource'
                    Type='string'
                    Value='msi-corporate'
                    KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='StartMenuShortcut' Guid='*'>
                <Shortcut
                    Id='StartMenuShortcut'
                    Name='Honk300'
                    Target='[Bin]honk300.exe'
                    Arguments='start'
                    WorkingDirectory='Bin'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\Honk300' Name='StartMenuShortcut' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id='APPLICATIONFOLDER'>
            <Component Id='LoginAutostart' Guid='*'>
                <RegistryValue
                    Root='HKCU'
                    Key='Software\Microsoft\Windows\CurrentVersion\Run'
                    Name='Honk300'
                    Type='string'
                    Value='"[Bin]honk300.exe" start'
                    KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='honk300'
            Description='Installs honk300, honk, and goose command aliases.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='Honk300Exe'/>
            <ComponentRef Id='HonkAliasExe'/>
            <ComponentRef Id='GooseAliasExe'/>
            <ComponentRef Id='InstallSourceMarkerFile'/>
            <ComponentRef Id='LegalNotices'/>
            <ComponentRef Id='InstallSourceMarker'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <Feature Id='Environment' Title='PATH Environment Variable' Description='Add honk300 to the user PATH.' Level='1' Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
            <Feature Id='Autostart' Title='Login Autostart' Description='Start honk300 when this user logs in.' Level='2' Absent='allow'>
                <ComponentRef Id='LoginAutostart'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/RealEmmettS/goose'/>

        <WixVariable Id='WixUILicenseRtf' Value='$(var.SourceRoot)\wix\honk300-license.rtf'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>
    </Product>
</Wix>
